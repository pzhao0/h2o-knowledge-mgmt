FROM registry.access.redhat.com/ubi9/python-312:latest@sha256:f793a102147ffa00b45ccb88ae91d726c17ac2f7e70214eef0cbfdc32816ec01

WORKDIR /opt/app-root/src

COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /uvx /bin/
COPY --chown=1001:0 services/api/pyproject.toml services/api/uv.lock ./
COPY --chown=1001:0 services/api/src ./src

RUN uv sync --locked --no-dev --no-cache

ENV PATH="/opt/app-root/src/.venv/bin:${PATH}"

EXPOSE 8000

CMD ["uvicorn", "h2o_knowledge_mgmt_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
