FROM registry.access.redhat.com/ubi9/python-312-minimal:latest

WORKDIR /opt/app-root/src

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/
COPY --chown=1001:0 services/document-uploader/pyproject.toml services/document-uploader/uv.lock ./
COPY --chown=1001:0 services/document-uploader/src ./src

RUN uv sync --locked --no-dev --no-cache

ENV PATH="/opt/app-root/src/.venv/bin:${PATH}"

CMD ["/opt/app-root/src/.venv/bin/python", "-m", "document_uploader"]
