FROM registry.access.redhat.com/ubi9/python-312-minimal:latest@sha256:8d9955078019f81659230b378bf916da4cd63ccc82f7f88a40ab642730cb776f

WORKDIR /opt/app-root/src

COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /uvx /bin/
COPY --chown=1001:0 services/document-uploader/pyproject.toml services/document-uploader/uv.lock ./
COPY --chown=1001:0 services/document-uploader/src ./src

RUN uv sync --locked --no-dev --no-cache

ENV PATH="/opt/app-root/src/.venv/bin:${PATH}"

CMD ["/opt/app-root/src/.venv/bin/python", "-m", "document_uploader"]
