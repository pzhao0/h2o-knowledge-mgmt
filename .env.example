# Copy this file to .env and fill in the values:
#   cp .env.example .env
# .env is ignored by Git. Don't commit it, because it contains credentials.
# The installation scripts read this file as Bash variables: don't add spaces around "=".

# --- H2O container registry (from your H2O trial email) ---
# Registry that hosts the h2oGPTe images and Helm chart.
H2O_REGISTRY=docker.io/h2oairelease
H2O_REGISTRY_USERNAME=
H2O_REGISTRY_TOKEN=

# --- h2oGPTe license (from your H2O trial email) ---
H2OGPTE_LICENSE=

# --- Installation ---
# Version of the H2O AI Cloud Helm chart that installs h2oGPTe.
H2O_CHART_VERSION=5.2.1
# Namespace for h2oGPTe.
NAMESPACE=h2o-knowledge-mgmt

# --- Passwords ---
# Default passwords are for testing only. Set your own passwords if other people can reach the h2oGPTe URL.
# Password rules: at least 14 characters , and none of these characters: " ' \ ;
# Keycloak administrator password.
KEYCLOAK_ADMIN_PASSWORD=adminadminadmin
# Password of the h2oGPTe admin user that the installation creates.
H2OGPTE_ADMIN_PASSWORD=adminadminadmin
