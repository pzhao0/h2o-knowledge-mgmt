# Copy to .env and fill in the values.
# .env is ignored by Git and included as Make syntax: do not quote values.
# Escape literal dollar signs as $$ and hash characters as \#.

# External OpenAI-compatible API base, e.g. https://maas.example.com/v1.
# Supply the exact model identifier advertised by that service.
LLM_BASE_URL=
LLM_MODEL=

# Optional Bearer token. make deploy creates the LLM Secret automatically.
# Leave empty for an unauthenticated endpoint.
LLM_API_KEY=

STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
